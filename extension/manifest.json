{
  "manifest_version": 3,
  "name": "Jeradin — Screen Intelligence",
  "version": "1.0.0",
  "description": "Capture any tab and get an instant AI-powered debugging report from your Jeradin workspace.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://jeradin.com/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jeradin — capture & analyze",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
